#!/bin/sh /etc/rc.common
# cake-autorate: one procd instance per enabled 'instance' section of /etc/config/cake-autorate.
#   service cake-autorate stop <id>     stop one instance (until the next reload)
#   service cake-autorate reload        (re)start instances whose config changed or that are missing
# An instance with manage_sqm=1 switches its linked SQM queue (sqm-lib.sh) on when it
# starts and off when it is stopped or disabled.
# shellcheck disable=SC2034
USE_PROCD=1
START=97
STOP=4

SCRIPT_PREFIX="${CAKE_AUTORATE_SCRIPT_PREFIX:-/usr/lib/cake-autorate}"
CONFIG_PREFIX="${CAKE_AUTORATE_CONFIG_PREFIX:-/var/etc/cake-autorate}"
UCI_TO_CONFIG="${CAKE_AUTORATE_UCI_TO_CONFIG:-${SCRIPT_PREFIX}/uci-to-config.sh}"
SQM_LIB="${CAKE_AUTORATE_SQM_LIB:-${SCRIPT_PREFIX}/sqm-lib.sh}"
# Without the lib nothing SQM-related is done at all (no rate sync, no switching),
# so no sqm edit is ever staged without being committed.
SQM_LIB_OK=0
if [ -r "$SQM_LIB" ]; then
	# shellcheck source=sqm-lib.sh
	. "$SQM_LIB" && SQM_LIB_OK=1
fi

# SQM changes are staged with `uci set` during one start/stop pass and applied at its
# end with at most one `uci commit sqm` + one sqm reload (none when nothing changed).
SQM_DIRTY=0
SQM_ON=
SQM_OFF=
SQM_SHUTDOWN=0
SQM_STOP_IDS=
SQM_LIB_WARNED=

# sqm_lib_ok: 0 when sqm-lib.sh is loaded; otherwise log (once per pass) and return 1
sqm_lib_ok() {
	[ "$SQM_LIB_OK" -eq 1 ] && return 0
	[ -n "$SQM_LIB_WARNED" ] && return 1
	SQM_LIB_WARNED=1
	logger -t cake-autorate "$SQM_LIB missing: SQM rate sync and manage_sqm skipped (reinstall cake-autorate)"
	return 1
}

# base_rate dl|ul <rendered config>: the last base rate line (instance options are
# emitted after global ones, so they win), unquoted; defaults.sh only when the
# rendered config has no such line at all.
base_rate() {
	# shellcheck disable=SC3043 # 'local' is a busybox ash/dash builtin; OpenWrt's own functions.sh relies on it.
	local key="base_$1_shaper_rate_kbps" v
	if grep -q "^$key=" "$2"; then
		v=$(sed -n "s/^$key=//p" "$2" | tail -n 1)
		v=${v#\"}; v=${v%\"}
	else
		v=$(sed -n "s/^$key=\([0-9]*\).*/\1/p" "$SCRIPT_PREFIX/defaults.sh")
	fi
	printf '%s' "$v"
}

# sqm_sync_base_rates: keep the linked SQM queue at this instance's base rates.
sync_sqm_rates() {
	# shellcheck disable=SC3043 # 'local' is a busybox ash/dash builtin; OpenWrt's own functions.sh relies on it.
	local id="$1" sync sqm dl ul cur_dl cur_ul cfg="$CONFIG_PREFIX/config.$1.sh"
	config_get_bool sync "$id" sqm_sync_base_rates 0
	config_get sqm "$id" sqm_instance
	[ "$sync" -eq 1 ] && [ -n "$sqm" ] || return 0
	sqm_lib_ok || return 0
	[ "$(uci -q get "sqm.$sqm")" = "queue" ] || return 0
	dl=$(base_rate dl "$cfg"); ul=$(base_rate ul "$cfg")
	# never fall back to defaults.sh over an explicit non-integer value, never set an empty rate
	case "$dl" in ''|*[!0-9]*) logger -t cake-autorate "instance '$id': base_dl_shaper_rate_kbps '$dl' is not a whole number, SQM queue '$sqm' left unchanged"; return 0 ;; *) ;; esac
	case "$ul" in ''|*[!0-9]*) logger -t cake-autorate "instance '$id': base_ul_shaper_rate_kbps '$ul' is not a whole number, SQM queue '$sqm' left unchanged"; return 0 ;; *) ;; esac
	cur_dl=$(uci -q get "sqm.$sqm.download"); cur_ul=$(uci -q get "sqm.$sqm.upload")
	[ "$cur_dl" = "$dl" ] && [ "$cur_ul" = "$ul" ] && return 0
	uci -q set "sqm.$sqm.download=$dl"; uci -q set "sqm.$sqm.upload=$ul"
	SQM_DIRTY=1
	logger -t cake-autorate "instance '$id': SQM queue '$sqm' set to base rates $dl/$ul kbit/s"
}

# shellcheck disable=SC2154 # SQM_QUEUE is set by sqm_resolve_queue (sqm-lib.sh)
# sqm_note_managed <instance> on|off: remember the linked queue of a manage_sqm=1 instance.
sqm_note_managed() {
	# shellcheck disable=SC3043 # 'local' is a busybox ash/dash builtin; OpenWrt's own functions.sh relies on it.
	local manage
	config_get_bool manage "$1" manage_sqm 0
	[ "$manage" -eq 1 ] || return 0
	sqm_lib_ok || return 0
	sqm_resolve_queue "$1" || return 0
	case "$2" in
		on) SQM_ON="$SQM_ON $SQM_QUEUE=$1" ;;
		*) SQM_OFF="$SQM_OFF $SQM_QUEUE=$1" ;;
	esac
}

# shellcheck disable=SC2154 # SQM_CHANGE is set by sqm_queue_enable (sqm-lib.sh)
# sqm_manage_apply: switch off queues of disabled managed instances (unless a started
# instance uses the same queue), switch on those of started ones, then commit once.
sqm_manage_apply() {
	# shellcheck disable=SC3043 # 'local' is a busybox ash/dash builtin; OpenWrt's own functions.sh relies on it.
	local t q
	sqm_lib_ok || return 0
	for t in $SQM_OFF; do
		q=${t%%=*}
		case " $SQM_ON " in *" $q="*) continue ;; *) ;; esac
		if sqm_queue_disable "$q"; then
			SQM_DIRTY=1
			logger -t cake-autorate "instance '${t#*=}': SQM queue '$q' switched off (instance disabled, manage_sqm=1)"
		fi
	done
	for t in $SQM_ON; do
		q=${t%%=*}
		if sqm_queue_enable "$q"; then
			SQM_DIRTY=1
			logger -t cake-autorate "instance '${t#*=}': SQM queue '$q' $SQM_CHANGE (manage_sqm=1)"
		fi
	done
	sqm_commit
}

sqm_commit() {
	[ "$SQM_DIRTY" -eq 1 ] || return 0
	SQM_DIRTY=0
	sqm_apply || logger -t cake-autorate "uci commit sqm failed, SQM changes not applied"
}

# sqm_stop_instance <instance>: switch off the linked queue of a manage_sqm=1 instance.
sqm_stop_instance() {
	# shellcheck disable=SC3043 # 'local' is a busybox ash/dash builtin; OpenWrt's own functions.sh relies on it.
	local manage
	config_get_bool manage "$1" manage_sqm 0
	[ "$manage" -eq 1 ] || return 0
	sqm_lib_ok || return 0
	sqm_resolve_queue "$1" || return 0
	if sqm_queue_disable "$SQM_QUEUE"; then
		SQM_DIRTY=1
		logger -t cake-autorate "instance '$1': SQM queue '$SQM_QUEUE' switched off (instance stopped, manage_sqm=1)"
	fi
}

start_instance() {
	# shellcheck disable=SC3043 # 'local' is a busybox ash/dash builtin; OpenWrt's own functions.sh relies on it.
	local id="$1" enabled

	config_get_bool enabled "$id" enabled 0
	if [ "$enabled" -ne 1 ]; then
		sqm_note_managed "$id" off
		return 0
	fi

	if ! "$UCI_TO_CONFIG" "$id"; then
		logger -t cake-autorate "instance '$id': failed to render config from UCI, not starting"
		return 1
	fi

	sync_sqm_rates "$id"
	sqm_note_managed "$id" on

	procd_open_instance "$id"
	procd_set_param command "$SCRIPT_PREFIX/cake-autorate.sh" "$CONFIG_PREFIX/config.$id.sh"
	procd_set_param env CAKE_AUTORATE_SCRIPT_PREFIX="$SCRIPT_PREFIX" CAKE_AUTORATE_CONFIG_PREFIX="$CONFIG_PREFIX"
	procd_set_param file "$CONFIG_PREFIX/config.$id.sh"
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	mkdir -p "$CONFIG_PREFIX"
	SQM_DIRTY=0; SQM_ON=; SQM_OFF=; SQM_LIB_WARNED=
	config_load cake-autorate
	config_foreach start_instance instance
	# before start_service returns, i.e. before procd launches the instances
	sqm_manage_apply
}

# rc.common (procd) stop(): procd_lock; stop_service "$@"; procd_kill <service> "$1";
# service_stopped. $1 is the instance of `service cake-autorate stop <id>`, empty for a
# full stop. stop_service only records the instances; the queues are switched off in
# service_stopped, i.e. after procd_kill, so a still-running instance's tc calls and its
# exit-time CAKE reset do not hit a qdisc that sqm is tearing down.
# restart = stop + start, so managed SQM goes off and on again; reload does not stop.
sqm_record_stop() { SQM_STOP_IDS="$SQM_STOP_IDS $1"; }

stop_service() {
	SQM_STOP_IDS=
	[ "$SQM_SHUTDOWN" -eq 1 ] && return 0
	config_load cake-autorate
	if [ -n "$1" ]; then
		case "$1" in *[!A-Za-z0-9_]*) return 0 ;; *) ;; esac
		[ "$(config_get "$1" TYPE)" = "instance" ] && sqm_record_stop "$1"
	else
		config_foreach sqm_record_stop instance
	fi
	return 0
}

service_stopped() {
	# shellcheck disable=SC3043 # 'local' is a busybox ash/dash builtin; OpenWrt's own functions.sh relies on it.
	local id
	[ -n "$SQM_STOP_IDS" ] || return 0
	SQM_DIRTY=0; SQM_LIB_WARNED=
	for id in $SQM_STOP_IDS; do
		sqm_stop_instance "$id"
	done
	SQM_STOP_IDS=
	sqm_commit
}

# At system shutdown (procd runs `K* shutdown`, rc.common's default is `stop`) leave the
# sqm config alone: the K link only exists while the service is enabled, so the next boot
# starts it and switches the queue on anyway; switching it off here would only cost two
# flash writes per reboot. A reboot therefore leaves SQM as it is.
shutdown() {
	SQM_SHUTDOWN=1
	stop
}

# procd compares the new instance set with the running one and only restarts
# instances whose command/env/file changed; unchanged instances keep running.
reload_service() {
	# rc.common invokes reload_service WITHOUT the procd service context that
	# rc_procd provides for start; calling start_service bare would emit the
	# instance definitions into the void. rc_procd wraps it correctly and
	# procd then diffs: only changed/new instances are (re)started.
	rc_procd start_service
}

service_triggers() {
	procd_add_reload_trigger cake-autorate
}
